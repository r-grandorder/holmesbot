DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
# Local dev only. With docker-compose the image keeps the SQLite DB on the /data volume.
DATABASE_URL=sqlite:./database/holmesbot.sqlite3
GUILD_IDS=
HEALTH_PORT=8080
LOG_LEVEL=INFO
# Public base URL of the S3 assets bucket (silhouettes for /guess_shadow), e.g.
# https://bunyanbot-assets-327760835875.s3.us-east-1.amazonaws.com
ASSETS_BASE_URL=
# Custom QP currency emote for THIS bot application, e.g. <:qp:123456789012345678>
# (upload it under the app's emojis). Falls back to plain "QP" if unset.
QP_EMOTE=
# XP-item emotes for THIS bot app (optional; working defaults ship in config.py). Uncomment to
# point at your own uploaded emotes, or set empty (e.g. EMBER_EMOTE=) to show plain item names.
#EMBER_EMOTE=<:ember:1535158371098038322>
#HELLFIRE_EMOTE=<:hellfire:1535158395668009031>
# Repost the active game prompt after this many channel messages, so it doesn't
# scroll out of view (0 = never repost; try ~10 for a busy channel).
REPOST_AFTER=0

# --- Automated SQLite -> S3 backups (optional; off unless BACKUP_S3_BUCKET is set) ---
# Use a PRIVATE bucket -- NOT the public assets bucket. `terraform apply` creates one plus a
# scoped IAM user (see terraform/backup.tf); copy its outputs here. On-demand: /dbbackup (mods).
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db-backups/
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=30
# AWS creds for the backup upload (standard boto3 env chain). From the terraform IAM-user output.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Read-only web dashboard (optional; off unless all four below are set + DISCORD_CLIENT_SECRET) ---
# Discord-OAuth login, then read-only views of inventory / servants / leaderboards / wars.
# Generate a random secret: `openssl rand -hex 32`. api_base_url is the API's public URL (the
# Cloudflare Tunnel hostname); add "<api_base_url>/api/auth/callback" as a redirect in the Discord
# app's OAuth2 settings. frontend_url is where the SPA (Cloudflare Pages) lives + the allowed origin.
DASHBOARD_SESSION_SECRET=
DASHBOARD_API_BASE_URL=
DASHBOARD_FRONTEND_URL=
# Guild to scope the dashboard to (defaults to the first of GUILD_IDS if left 0).
DASHBOARD_GUILD_ID=0
